# Supabase — required for authentication, database access, and resume storage.
# Find both values in Supabase Dashboard → your project → Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback for projects that still show an anon key instead of a
# publishable key. Leave blank when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used in Supabase email-confirmation redirects.
# Local: http://localhost:3000  Production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI is optional. The CRM remains fully usable when these are blank.
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Generate a separate 32-byte random value for the server-to-database AI RPC
# capability. Never reuse the OpenAI key or expose this with NEXT_PUBLIC_.
AI_RPC_SECRET=

# Optional CLI convenience for remote type generation/documentation. This is
# the short project reference from the Supabase project URL, not a secret key.
SUPABASE_PROJECT_REF=
